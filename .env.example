# Copy to .env for local use. Never commit a real .env file.
# Every deployed instance must set DATABASE_URL, JWT_SECRET and CORS_ORIGINS.

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# SQLAlchemy URL. Defaults to a local SQLite file when unset.
# Render/Neon/Supabase use the postgresql:// form; the app rewrites it to
# postgresql+psycopg:// internally.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=sqlite:///./bridge_lifecycle.sqlite3

# Token-signing key. REQUIRED in production. Without it the API falls back to a
# publicly known development key and logs a warning; do not rely on that.
JWT_SECRET=replace-with-a-long-random-string

# Browser origins allowed to call the API, comma separated. Must match the
# frontend origin exactly or the browser will block every request.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------

# Base URL of the API, read at build time by Next.js.
# Must be reachable from the browser, so use the public https URL, not localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000
